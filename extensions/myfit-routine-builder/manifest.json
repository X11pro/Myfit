{
  "manifest_version": 3,
  "name": "Myfit Routine Builder",
  "version": "0.1.0",
  "description": "Create weekly Myfit routines from Chrome.",
  "permissions": ["storage"],
  "host_permissions": ["https://*.supabase.co/*"],
  "action": {
    "default_title": "Myfit Routine Builder",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
